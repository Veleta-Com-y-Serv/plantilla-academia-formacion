---
// Layout base de la plantilla. NO TOCAR salvo orden explícita de diseño.
// Pone el idioma, las metas SEO (src/lib/seo.ts: canónica, og, robots y JSON-LD), los colores de site.yaml como variables CSS, la cabecera y el pie.
// Además calcula --c-sobre-primario y --c-sobre-acento (texto blanco o oscuro según lo claro que sea cada color),
// para que botones y bandas sigan siendo legibles si el cliente cambia los colores.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { altHero, canonica, imagenCompartir, indexable, jsonLdNegocio, jsonLdPreguntas, jsonSeguro, urlBase } from '../lib/seo';

interface Props { titulo?: string; descripcion?: string }
const { titulo, descripcion } = Astro.props;

const VARIANTE_CABECERA = 'escuela';
const VARIANTE_PIE = 'indigo';

const title = titulo ? `${titulo} · ${site.nombre}` : site.seo.titulo;
const description = descripcion ?? site.seo.descripcion;
const c = site.colores;
function luminancia(hex: string) {
  let h = String(hex).trim().replace('#', '');
  if (h.length === 3) h = h.split('').map((x) => x + x).join('');
  if (!/^[0-9a-f]{6}$/i.test(h)) return 0;
  const [r, g, b] = [0, 2, 4].map((i) => {
    const v = parseInt(h.slice(i, i + 2), 16) / 255;
    return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}
const sobre = (hex: string) => (luminancia(hex) > 0.2 ? (luminancia(c.texto) < 0.08 ? c.texto : '#111111') : '#ffffff');
const variables =
  `--c-primario:${c.primario};--c-acento:${c.acento};--c-fondo:${c.fondo};--c-texto:${c.texto};` +
  `--c-sobre-primario:${sobre(c.primario)};--c-sobre-acento:${sobre(c.acento)}`;
// SEO de base (src/lib/seo.ts): dirección canónica (seo.url o SITE_URL), foto para compartir, indexación y JSON-LD.
const base = urlBase(Astro.site);
const canonical = canonica(Astro.url.pathname, base);
const imagen = imagenCompartir(base);
const ld = jsonLdNegocio(base, 'LocalBusiness');
const ldPreguntas = Astro.url.pathname === '/' ? jsonLdPreguntas() : null;
---

<!doctype html>
<html lang="es-ES" style={variables}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={c.primario} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!indexable() && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.nombre} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imagen && <meta property="og:image" content={imagen} />}
    {imagen && <meta property="og:image:alt" content={altHero()} />}
    <meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />
    <script type="application/ld+json" set:html={jsonSeguro(ld)} />
    {ldPreguntas && <script type="application/ld+json" set:html={jsonSeguro(ldPreguntas)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header variante={VARIANTE_CABECERA} cta={site.boton_cabecera} />
    <main id="contenido">
      <slot />
    </main>
    <Footer variante={VARIANTE_PIE} />
  </body>
</html>
