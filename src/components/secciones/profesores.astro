---
// Profesores: retrato (silueta /placeholders/persona.svg salvo foto del cliente) sobre un bloque de color desplazado,
// nombre, materia y texto. Campos: `personas[]` (nombre, cargo, foto, texto).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const personas = s ? s.personas.filter((p) => p && p.nombre) : [];
const fondos = ['bg-acento', 'bg-primario', 'bg-[var(--lima-suave)]', 'bg-[var(--indigo-suave)]'];
---

{
  s && personas.length > 0 && (
    <Seccion id={Astro.props.id}>
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul class:list={['grid gap-x-8 gap-y-12 sm:grid-cols-2', personas.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
        {personas.map((p, i) => (
          <li>
            <div class="relative mr-3 mt-3">
              <span class:list={['absolute -right-3 -top-3 h-full w-full esquina', fondos[i % fondos.length]]} aria-hidden="true" />
              <Imagen src={p.foto || '/placeholders/persona.svg'} alt={p.nombre} ancho={600} alto={720} class="esquina relative aspect-[5/6] w-full object-cover" />
            </div>
            <p class="mt-6 text-xl font-extrabold tracking-tight text-primario">{p.nombre}</p>
            {p.cargo && <p class="mt-1 text-sm font-bold uppercase tracking-[.06em] opacity-70">{p.cargo}</p>}
            {p.texto && <p class="mt-3 text-[.98rem] opacity-80">{p.texto}</p>}
          </li>
        ))}
      </ul>
    </Seccion>
  )
}
