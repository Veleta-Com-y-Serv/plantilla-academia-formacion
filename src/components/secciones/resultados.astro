---
// Resultados: cifras grandes con subrayado lima + texto e imagen opcional. Campos: `items[]` (titulo = la cifra,
// p. ej. "92 %"; texto = qué mide), `texto`, `imagen`. Sin ninguna cifra, la sección no se pinta.
import { seccion, valor } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const cifras = s ? s.items.filter((it) => valor(it.titulo)) : [];
---

{
  s && cifras.length > 0 && (
    <Seccion id={Astro.props.id} class="banda-gris">
      <div class:list={['grid items-center gap-12', s.imagen && 'lg:grid-cols-2 lg:gap-16']}>
        <div>
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-10" />
          <dl class:list={['grid grid-cols-2 gap-4', !s.imagen && cifras.length >= 4 && 'md:grid-cols-4']}>
            {cifras.map((c, i) => (
              <div class:list={['esquina p-5 md:p-6', i % 3 === 0 ? 'bg-primario text-[var(--c-sobre-primario)]' : 'bg-[var(--c-fondo)] ring-1 ring-texto/10']}>
                <dt class="text-[clamp(2.1rem,6vw,3.2rem)] font-extrabold leading-none tracking-tight">{c.titulo}</dt>
                <dd>
                  <span class="mt-3 block h-1.5 w-10 rounded-full bg-acento" aria-hidden="true" />
                  {c.texto && <span class="mt-3 block text-sm font-semibold opacity-85">{c.texto}</span>}
                </dd>
              </div>
            ))}
          </dl>
        </div>
        {s.imagen && (
          <div class="relative">
            <span class="absolute -left-4 -top-4 h-2/3 w-2/3 rounded-full bg-acento/60" aria-hidden="true" />
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} class="esquina relative aspect-[4/3] w-full object-cover" />
          </div>
        )}
      </div>
    </Seccion>
  )
}
