---
// Ficha de un curso con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /cursos/<slug>/.
// Diseño «aula fresca»: banda índigo con migas y hero partido (título blanco, insignias de nivel y modalidad, precio,
// botón lima de inscripción y WhatsApp; a la derecha la foto con esquinas grandes y bloque lima detrás o, sin foto, el
// icono en una tarjeta); banda blanca con el `detalle` y, al lado, la tarjeta de datos con banda de color y la caja de
// inscripción; fotos (`imagenes`) en banda gris y otros cursos de la misma lista como tarjetas con banda superior.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const cita = seccion('inscripcion') ? '/#inscripcion' : site.boton_cabecera?.url || '/#contacto';
const textoCita = (seccion(f.idSeccion) as any)?.cta?.texto || site.boton_cabecera?.texto || 'Inscribirme';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const nivel = f.datos.find((d) => d.clave === 'nivel')?.valor ?? '';
const modalidad = f.datos.find((d) => d.clave === 'modalidad')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-indigo ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {(nivel || modalidad) && (
            <p class="ficha-chips">
              {nivel && <span class="insignia insignia--indigo">{nivel}</span>}
              {modalidad && <span class="insignia insignia--lima">{modalidad}</span>}
            </p>
          )}
          {f.precio && <p class="ficha-precio-hero">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn" href={cita}>{textoCita}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto-caja">
            <div class="ficha-foto">
              <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={800} prioridad class="h-full w-full object-cover" />
            </div>
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'birrete'} tam={96} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="tarjeta ficha-datos">
            <span class="ficha-banda" aria-hidden="true"></span>
            <div class="ficha-datos-cuerpo">
              <h2 class="ficha-lado-titulo">El curso en pocas palabras</h2>
              <dl>
                {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
                {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
              </dl>
            </div>
          </div>
        )}
        <div class="ficha-cita banda-indigo">
          <p class="ficha-cita-titulo">¿Te guardamos una plaza?</p>
          <p>Haz la prueba de nivel sin compromiso y te decimos qué grupo te encaja.</p>
          <a class="btn" href={cita}>{textoCita}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda-gris ficha-franja" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda-gris ficha-franja">
      <div class="contenedor">
        <div class="titular">
          <p class="antetitulo">{nombreSeccion}</p>
          <h2 class="titulo-seccion">Otros cursos</h2>
        </div>
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="tarjeta ficha-otra">
              <span class="ficha-banda" aria-hidden="true"></span>
              <div class="ficha-otra-cuerpo">
                <span class="icono-cuadro"><Icono nombre={o.icono || 'birrete'} tam={24} /></span>
                <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
                {o.texto && <p class="ficha-otra-texto">{o.texto}</p>}
                <p class="ficha-otra-pie">
                  {o.precio && <span class="ficha-precio">{o.precio}</span>}
                  <span class="ficha-otra-ver" aria-hidden="true">Ver curso <Icono nombre="flecha" tam={16} /></span>
                </p>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn btn-indigo" href={`/#${f.idSeccion}`}>Ver todos los cursos</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); overflow: hidden; }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 650; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .6; }
  .migas a { color: var(--c-sobre-primario); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .8; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.2rem, 6vw, 4.2rem); overflow-wrap: anywhere; }
  .ficha-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
  .ficha-precio-hero { margin-top: 1.25rem; font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; color: var(--c-acento); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 2.75rem; }
  .ficha-foto-caja { position: relative; padding: 0 0 .9rem .9rem; }
  .ficha-foto-caja::before { content: ""; position: absolute; inset: .9rem .9rem 0 0; border-radius: var(--esquina); background: var(--c-acento); transform: rotate(-2deg); }
  .ficha-foto { position: relative; aspect-ratio: 3 / 2; border-radius: var(--esquina); overflow: hidden; background: var(--gris); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 3 / 2; border-radius: var(--esquina); background: var(--c-acento); color: var(--c-sobre-acento); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.1rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-banda { display: block; height: .75rem; background: var(--c-primario); }
  .ficha-datos { overflow: hidden; }
  .ficha-datos-cuerpo { padding: 1.5rem; }
  .ficha-lado-titulo { font-size: 1.3rem; margin-bottom: 1rem; color: var(--c-primario); }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 0; border-top: 1px solid var(--linea); }
  .ficha-datos dt { font-weight: 700; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-precio { font-weight: 800; font-size: 1.2rem; color: var(--c-primario); }
  .ficha-cita { display: grid; gap: .9rem; border-radius: var(--esquina); padding: 1.75rem 1.5rem; }
  .ficha-cita-titulo { font-size: 1.5rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 800; color: inherit; text-decoration: none; }
  .ficha-franja { padding-block: var(--ritmo); }
  .ficha-franja + .ficha-franja { padding-top: 0; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 3 / 2; border-radius: var(--esquina); overflow: hidden; }
  .ficha-otras { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; overflow: hidden; }
  .ficha-otra-cuerpo { display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; height: calc(100% - .75rem); }
  .ficha-otra h3 { font-size: 1.3rem; color: var(--c-primario); overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-acento); outline-offset: 2px; }
  .ficha-otra:hover { border-color: var(--c-primario); }
  .ficha-otra-texto { opacity: .8; font-size: .98rem; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 800; color: var(--c-primario); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
